{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streamed-pk-resolver",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-17",
  "containers": [
    {
      "class_name": "ResolverContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RESOLVER",
        "class_name": "ResolverContainer"
      }
    ]
  },
  "exports": {
    "ResolverContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
